# Application Admin Secrets (Grafana, Argo CD, Kargo)
# This file is the template. The real file (app-admin-secrets.yaml) should be gitignored.
#
# 1. Copy: cp 0day-deployment-manifests/app-admin-secrets.yaml.example 0day-deployment-manifests/app-admin-secrets.yaml
# 2. Replace placeholders with real passwords/hashes
# 3. Apply: kubectl apply -f 0day-deployment-manifests/app-admin-secrets.yaml
---
apiVersion: v1
kind: Secret
metadata:
  name: grafana-admin-credentials
  namespace: grafana
  labels:
    app.kubernetes.io/part-of: grafana
type: Opaque
stringData:
  # The username for the admin account
  admin-user: admin
  # The password for the 'admin' user
  admin-password: REPLACE_WITH_GRAFANA_ADMIN_PASSWORD
---
# Argo CD admin password
apiVersion: v1
kind: Secret
metadata:
  name: argocd-admin-password
  namespace: argocd
  labels:
    app.kubernetes.io/part-of: argocd
type: Opaque
stringData:
  # Bcrypt hash of the admin password
  password: REPLACE_WITH_ARGOCD_ADMIN_PASSWORD_HASH
---
apiVersion: v1
kind: Secret
metadata:
  name: kargo-admin-credentials
  namespace: kargo
  labels:
    app.kubernetes.io/part-of: kargo
type: Opaque
stringData:
  # Bcrypt hash of the admin password
  password-hash: REPLACE_WITH_KARGO_ADMIN_PASSWORD_HASH
  # Token signing key
  token-signing-key: REPLACE_WITH_KARGO_TOKEN_SIGNING_KEY
