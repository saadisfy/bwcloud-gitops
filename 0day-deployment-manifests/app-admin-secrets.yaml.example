# Application Admin Secrets (Grafana, Argo CD, Kargo)
# =========================================================
# This file is a TEMPLATE. The real secrets live ONLY in the cluster.
#
# 1. Copy: cp 0day-deployment-manifests/app-admin-secrets.yaml.example 0day-deployment-manifests/app-admin-secrets.yaml
# 2. Generate NEW passwords/hashes (Rotation!)
# 3. Fill in the values below
# 4. Apply: kubectl apply -f 0day-deployment-manifests/app-admin-secrets.yaml
# 5. RECOMMENDED: Delete the local .yaml file after applying, or ensure it's gitignored.

---
# 1. GRAFANA ADMIN CREDENTIALS
apiVersion: v1
kind: Secret
metadata:
  name: grafana-admin-credentials
  namespace: grafana
  labels:
    app.kubernetes.io/part-of: grafana
type: Opaque
stringData:
  admin-user: admin
  admin-password: CHANGE_ME_TO_A_NEW_PASSWORD

---
# 2. ARGO CD MAIN SECRET
# This secret contains the admin password AND the server key.
# Since we set 'createSecret: false' in the Helm chart, this is MANDATORY.
apiVersion: v1
kind: Secret
metadata:
  name: argocd-secret
  namespace: argocd
  labels:
    app.kubernetes.io/part-of: argocd
type: Opaque
stringData:
  # Generate a NEW bcrypt hash (e.g. using 'htpasswd -nbB admin NEW_PASSWORD')
  admin.password: CHANGE_ME_TO_NEW_BCRYPT_HASH
  admin.passwordMtime: "2026-04-29T10:00:00Z"
  # Generate a NEW random 32+ char string for the server key
  server.secretkey: CHANGE_ME_TO_A_LONG_RANDOM_STRING

---
# 3. KARGO ADMIN CREDENTIALS (Manual Patch)
# Note: Similar to Argo CD, Kargo manages 'kargo-api' secret. 
# We patch it manually to keep it out of Git.
#
# Patch the secret:
# kubectl patch secret kargo-api -n kargo -p "{\"stringData\": {\"ADMIN_ACCOUNT_PASSWORD_HASH\": \"YOUR_BCRYPT_HASH\", \"ADMIN_ACCOUNT_TOKEN_SIGNING_KEY\": \"YOUR_BASE64_KEY\"}}"
