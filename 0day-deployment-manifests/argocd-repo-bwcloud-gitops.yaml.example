# Git repository definition for bwcloud-gitops.
# The repository is public, so Argo CD can read it over HTTPS without credentials.
# Add username/password only out-of-band if the repository becomes private.
---
apiVersion: v1
kind: Secret
metadata:
  name: repo-bwcloud-gitops
  namespace: argocd
  labels:
    argocd.argoproj.io/secret-type: repository
stringData:
  type: git
  name: bwcloud-gitops
  url: https://github.com/saadisfy/bwcloud-gitops.git
