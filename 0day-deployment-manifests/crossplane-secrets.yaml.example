# Grafana Credentials for Crossplane
# =========================================================
# This file is a TEMPLATE. The real credentials live ONLY in the cluster.
#
# 1. Copy: cp 0day-deployment-manifests/crossplane-secrets.yaml.example 0day-deployment-manifests/crossplane-secrets.yaml
# 2. Fill in the correct Grafana password (matching grafana-admin-credentials)
# 3. Apply: kubectl apply -f 0day-deployment-manifests/crossplane-secrets.yaml
# 4. RECOMMENDED: Delete the local .yaml file after applying, or ensure it's gitignored.
#
# Note: Pointing to Grafana local Service URL (port 80).
# The 'auth' field contains the 'username:password' string.
#

apiVersion: v1
kind: Secret
metadata:
  name: grafana-creds
  namespace: crossplane-system
type: Opaque
stringData:
  credentials: |
    {
      "url": "http://grafana.grafana.svc.cluster.local:80",
      "auth": "admin:CHANGE_ME_TO_GRAFANA_ADMIN_PASSWORD"
    }
