# Grafana Secrets (GitHub OAuth & SMTP)
# This file is the template. The real file (grafana-secrets.yaml) is gitignored.
#
# 1. Copy: cp 0day-deployment-manifests/grafana-secrets.yaml.example 0day-deployment-manifests/grafana-secrets.yaml
# 2. Replace placeholders with real values.
# 3. Apply: kubectl apply -f 0day-deployment-manifests/grafana-secrets.yaml
---
apiVersion: v1
kind: Secret
metadata:
  name: grafana-secrets
  namespace: grafana
  labels:
    app.kubernetes.io/part-of: grafana
type: Opaque
stringData:
  # GitHub OAuth
  GF_AUTH_GITHUB_CLIENT_ID: REPLACE_GRAFANA_CLIENT_ID
  GF_AUTH_GITHUB_CLIENT_SECRET: REPLACE_GRAFANA_CLIENT_SECRET
  
  # SMTP Settings
  GF_SMTP_HOST: "smtp.example.com:587"
  GF_SMTP_USER: "user@example.com"
  GF_SMTP_PASSWORD: "REPLACE_SMTP_PASSWORD"
  GF_SMTP_FROM_ADDRESS: "grafana@example.com"

  # Telegram Settings
  GF_TELEGRAM_BOT_TOKEN: "REPLACE_WITH_TELEGRAM_BOT_TOKEN"
  GF_TELEGRAM_CHAT_ID: "REPLACE_WITH_TELEGRAM_CHAT_ID"

---
# Argo CD reads referenced secrets via `$<secret-name>:<key>` interpolation in
# configs.cm/dex.config. The label `app.kubernetes.io/part-of: argocd` is what
# allows argocd-server / dex to load it.
apiVersion: v1
kind: Secret
metadata:
  name: argocd-github-oauth
  namespace: argocd
  labels:
    app.kubernetes.io/part-of: argocd
type: Opaque
stringData:
  clientID: REPLACE_ARGOCD_CLIENT_ID
  clientSecret: REPLACE_ARGOCD_CLIENT_SECRET
