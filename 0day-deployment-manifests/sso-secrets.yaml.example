# GitHub OAuth credentials for Grafana and Argo CD SSO.
# This file is the template. The real file (sso-secrets.yaml) is gitignored.
#
# 1. Copy: cp 0day-deployment-manifests/sso-secrets.yaml.example 0day-deployment-manifests/sso-secrets.yaml
# 2. Replace the placeholder client IDs/secrets below with the real values
#    from the GitHub OAuth Apps:
#       sso_grafana   -> https://github.com/settings/applications/<id>
#       sso_argo      -> https://github.com/settings/applications/<id>
#    GitHub callback URLs:
#       Grafana: https://grafana.saadisfy.me/login/github
#       Argo CD: https://argocd.saadisfy.me/api/dex/callback
# 3. Apply: kubectl apply -f 0day-deployment-manifests/sso-secrets.yaml
# 4. Reloader will roll the Grafana pod; Argo CD server/dex pick up the
#    secret on next reconcile.
---
apiVersion: v1
kind: Secret
metadata:
  name: grafana-github-oauth
  namespace: grafana
  labels:
    app.kubernetes.io/part-of: grafana
type: Opaque
stringData:
  GF_AUTH_GITHUB_CLIENT_ID: REPLACE_GRAFANA_CLIENT_ID
  GF_AUTH_GITHUB_CLIENT_SECRET: REPLACE_GRAFANA_CLIENT_SECRET
---
# Argo CD reads referenced secrets via `$<secret-name>:<key>` interpolation in
# configs.cm/dex.config. The label `app.kubernetes.io/part-of: argocd` is what
# allows argocd-server / dex to load it.
apiVersion: v1
kind: Secret
metadata:
  name: argocd-github-oauth
  namespace: argocd
  labels:
    app.kubernetes.io/part-of: argocd
type: Opaque
stringData:
  clientID: REPLACE_ARGOCD_CLIENT_ID
  clientSecret: REPLACE_ARGOCD_CLIENT_SECRET
