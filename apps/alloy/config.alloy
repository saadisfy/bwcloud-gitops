name: alloy
namespace: {{ .Release.Namespace }}
labels:
  app.kubernetes.io/name: alloy
  app.kubernetes.io/part-of: alloy-wrapper
config.alloy: |-
  // =================================================================
  // Alloy config – modular architecture (Receive -> Process -> Export)
  // =================================================================

  logging {
    level  = "info"
    format = "logfmt"
  }

  // ===============================================================
  // PHASE 3: EXPORT
  // ===============================================================

  local.file_match "queue_storage" {
    path_targets = [{"__path__" = "/tmp/alloy/queue"}]
  }

  otelcol.exporter.otlphttp "mimir" {
    client {
      endpoint = "http://mimir-distributor.mimir.svc.cluster.local:8080/otlp"
      headers = {
        "X-Scope-OrgID" = "1",
      }
    }
    sending_queue {
      enabled    = true
      queue_size = 5000
      storage    = local.file_match.queue_storage.targets[0] 
    }
    retry_on_failure {
      enabled          = true
      max_elapsed_time = "5m"
    }
  }

  // ===============================================================
  // PHASE 2: PROCESS (Central Enrichment & Label Mapping)
  // ===============================================================

  // --- Pipeline: Dual-Semantics (Enrichment & Legacy Label Mirroring) ---
  declare "otelcol_pipeline_dual_semantics" {
    argument "forward_to" {}
    argument "enable_k8s_enrichment" {
      optional = true
      default  = true
    }

    // 6. Batching (Optimized for Mimir)
    otelcol.processor.batch "default" {
      output { metrics = [argument.forward_to.value] }
      send_batch_size = 8192
      timeout         = "10s"
    }

    // 5. Dual-Semantics Mirroring (Resource -> Datapoint)
    otelcol.processor.transform "mirror_dual_semantics" {
      error_mode = "ignore"
      output { metrics = [otelcol.processor.batch.default.input] }

      metric_statements {
        context = "datapoint"
        statements = [
          // Map OTel Resource Attributes to legacy Prometheus Datapoint Labels
          "set(attributes[\"namespace\"], resource.attributes[\"k8s.namespace.name\"]) where resource.attributes[\"k8s.namespace.name\"] != nil",
          "set(attributes[\"pod\"],       resource.attributes[\"k8s.pod.name\"])       where resource.attributes[\"k8s.pod.name\"] != nil",
          "set(attributes[\"container\"], resource.attributes[\"k8s.container.name\"]) where resource.attributes[\"k8s.container.name\"] != nil",
          "set(attributes[\"node\"],      resource.attributes[\"k8s.node.name\"])      where resource.attributes[\"k8s.node.name\"] != nil",
          "set(attributes[\"cluster\"],   resource.attributes[\"k8s.cluster.name\"])   where resource.attributes[\"k8s.cluster.name\"] != nil",
        ]
      }

      metric_statements {
        context = "resource"
        statements = [
          "delete_key(attributes, \"k8s.pod.ip\")",
        ]
      }
    }

    // 4. Inject Cluster Name
    otelcol.processor.resource "inject_cluster" {
      output { metrics = [otelcol.processor.transform.mirror_dual_semantics.input] }
      attributes {
        action = "insert"
        key    = "k8s.cluster.name"
        value  = "prod-bwcloud"
      }
    }

    // 3. K8s Attributes Enrichment (Conditional)
    otelcol.processor.k8sattributes "enrich" {
      output { metrics = [otelcol.processor.resource.inject_cluster.input] }
      extract {
        metadata = ["k8s.namespace.name", "k8s.pod.name", "k8s.node.name", "k8s.deployment.name", "k8s.container.name"]
        deployment_name_from_replicaset = true
      }
      pod_association {
        source { from = "resource_attribute" name = "k8s.pod.ip" }
      }
      pod_association {
        source { from = "connection" }
      }
    }

    // 2. Promote Pod IP/Meta to Resource Level (for k8sattributes)
    otelcol.processor.transform "promote_meta" {
      output {
        metrics = [
          argument.enable_k8s_enrichment.value ? otelcol.processor.k8sattributes.enrich.input : otelcol.processor.resource.inject_cluster.input,
        ]
      }
      metric_statements {
        context = "datapoint"
        statements = [
          "set(resource.attributes[\"k8s.pod.ip\"], attributes[\"k8s_pod_ip\"]) where attributes[\"k8s_pod_ip\"] != nil",
          "set(resource.attributes[\"k8s.pod.name\"], attributes[\"pod\"]) where attributes[\"pod\"] != nil",
          "set(resource.attributes[\"k8s.namespace.name\"], attributes[\"namespace\"]) where attributes[\"namespace\"] != nil",
          "delete_key(attributes, \"k8s_pod_ip\")",
        ]
      }
    }

    // 1. Memory Limiter (OOM Protection) - Optimized for high-power node
    otelcol.processor.memory_limiter "default" {
      output { metrics = [otelcol.processor.transform.promote_meta.input] }
      check_interval  = "1s"
      limit           = "1000MiB"
      spike_limit     = "200MiB"
    }

    export "input" {
      value = otelcol.processor.memory_limiter.default.input
    }
  }
  // ===============================================================
  // PHASE 1: RECEIVE (Target-Specific Scrapes)
  // ===============================================================

  // ... (Modules are imported or defined in the ConfigMap)

  // ===============================================================
  // INSTANTIATION
  // ===============================================================

  otelcol_pipeline_dual_semantics "pod_level" {
    forward_to = otelcol.exporter.otlphttp.mimir.input
    enable_k8s_enrichment = true
  }

  otelcol_pipeline_dual_semantics "meta_level" {
    forward_to = otelcol.exporter.otlphttp.mimir.input
    enable_k8s_enrichment = false
  }

  otelcol_mimir_scrape "default" {
    forward_to = otelcol_pipeline_dual_semantics.pod_level.input
  }

  otelcol_alloy_scrape "default" {
    forward_to = otelcol_pipeline_dual_semantics.pod_level.input
  }

  otelcol_kubelet_scrape "default" {
    forward_to = otelcol_pipeline_dual_semantics.meta_level.input
  }

  otelcol_cadvisor_scrape "default" {
    forward_to = otelcol_pipeline_dual_semantics.meta_level.input
  }

  otelcol_ksm_scrape "default" {
    forward_to = otelcol_pipeline_dual_semantics.meta_level.input
  }

  otelcol_node_exporter_scrape "default" {
    forward_to = otelcol_pipeline_dual_semantics.meta_level.input
  }

