declare "scrape" {
	argument "forward_to" { }

	discovery.kubernetes "nodes" {
		role = "node"
	}

	discovery.relabel "kubelet" {
		targets = discovery.kubernetes.nodes.targets

		rule {
			source_labels = ["__meta_kubernetes_node_name"]
			regex         = sys.env("HOSTNAME")
			action        = "keep"
		}

		rule {
			source_labels = ["__meta_kubernetes_node_name"]
			target_label  = "node"
		}

		rule {
			target_label = "job"
			replacement  = "kubelet"
		}

		rule {
			target_label = "__scheme__"
			replacement  = "https"
		}

		rule {
			source_labels = ["__meta_kubernetes_node_address_InternalIP"]
			target_label  = "__address__"
			replacement   = "${1}:10250"
		}
	}

	// ==========================================
	// LOCAL METRIC DROP (Performance optimized)
	// ==========================================
	prometheus.relabel "drop_unwanted" {
		forward_to = [otelcol.receiver.prometheus.kubelet.receiver]

		// Example: Drop highly cardinal/noisy kubelet metrics right at scrape time
		rule {
			source_labels = ["__name__"]
			regex         = "container_network_receive_errors_total|example_noisy_metric_.*"
			action        = "drop"
		}
	}

	prometheus.scrape "kubelet" {
		targets = discovery.relabel.kubelet.output
		// Point forward_to to the local relabel rule instead of otelcol directly
		forward_to        = [prometheus.relabel.drop_unwanted.receiver]
		bearer_token_file = "/var/run/secrets/kubernetes.io/serviceaccount/token"

		tls_config {
			insecure_skip_verify = true
		}
		scrape_interval = "15s"
	}

	otelcol.receiver.prometheus "kubelet" {
		output {
			metrics = [argument.forward_to.value]
		}
	}
}
