declare "scrape" {
	argument "forward_to" { }

	discovery.kubernetes "nodes" {
		role = "node"
	}

	discovery.relabel "kubelet_resources" {
		targets = discovery.kubernetes.nodes.targets

		rule {
			source_labels = ["__meta_kubernetes_node_name"]
			regex         = sys.env("HOSTNAME")
			action        = "keep"
		}

		rule {
			source_labels = ["__meta_kubernetes_node_name"]
			target_label  = "node"
		}

		rule {
			target_label = "job"
			replacement  = "kubelet-resources"
		}

		rule {
			target_label = "__scheme__"
			replacement  = "https"
		}

		rule {
			target_label = "__metrics_path__"
			replacement  = "/metrics/resource"
		}

		rule {
			source_labels = ["__meta_kubernetes_node_address_InternalIP"]
			target_label  = "__address__"
			replacement   = "${1}:10250"
		}
	}

	prometheus.relabel "keep_core" {
		forward_to = [otelcol.receiver.prometheus.kubelet_resources.receiver]

		rule {
			source_labels = ["__name__"]
			regex         = "up|scrape_samples_scraped|node_cpu_usage_seconds_total|node_memory_working_set_bytes"
			action        = "keep"
		}
	}

	prometheus.scrape "kubelet_resources" {
		targets           = discovery.relabel.kubelet_resources.output
		forward_to        = [prometheus.relabel.keep_core.receiver]
		bearer_token_file = "/var/run/secrets/kubernetes.io/serviceaccount/token"
		scrape_interval   = "60s"
		scrape_timeout    = "10s"
		scrape_protocols  = ["OpenMetricsText1.0.0", "OpenMetricsText0.0.1", "PrometheusText0.0.4"]

		tls_config {
			ca_file              = "/var/run/secrets/kubernetes.io/serviceaccount/ca.crt"
			insecure_skip_verify = true
			server_name          = "kubernetes"
		}
	}

	otelcol.receiver.prometheus "kubelet_resources" {
		output {
			metrics = [argument.forward_to.value]
		}
	}
}
